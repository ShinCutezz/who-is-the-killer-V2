task.spawn(function()
	while task.wait(0.25) do
		local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			if UI.spd ~= 16 then hum.WalkSpeed = UI.spd end
			hum.UseJumpPower = true
			hum.JumpPower = UI.jmp
		end
		if UI.scan then UI.updateScan() end
		if UI.hb then UI.updateHitbox() end
		if UI.coin or UI.gun then
			local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
			if root then
				for _, o in ipairs(workspace:GetDescendants()) do
					if o:IsA("BasePart") and not o:IsDescendantOf(LP.Character) then
						local touch = o:FindFirstChildOfClass("TouchTransmitter") or (o.Parent and o.Parent:FindFirstChildOfClass("TouchTransmitter"))
						local isPlayer = Players:GetPlayerFromCharacter(o.Parent) or (o.Parent and Players:GetPlayerFromCharacter(o.Parent.Parent))
						if not isPlayer and ((UI.coin and touch and hasKey(o, COINS)) or (UI.gun and (touch or (o.Parent and o.Parent:IsA("Tool"))) and hasKey(o, GUNS))) then
							o.CanCollide = false; o.CFrame = root.CFrame
							if firetouchinterest then firetouchinterest(root, o, 0); firetouchinterest(root, o, 1) end
						end
					end
				end
			end
		end
	end
end)
