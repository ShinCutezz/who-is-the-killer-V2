local IGNORE_ITEMS = {"detective", "medic", "doctor", "jester", "clown", "engineer", "spy", "toy", "fake", "radio", "spray", "emote", "phone", "gg", "pet", "effect", "perk", "power"}

local function isIgnored(str)
	if not str or str == "" then return false end
	local s = tostring(str):lower()
	for _, k in ipairs(IGNORE_ITEMS) do
		if s:find(k, 1, true) then return true end
	end
	return false
end

local function checkToolType(tool)
	local n = tool.Name:lower()
	if isIgnored(n) then return nil end

	if n:find("knife") or n:find("dagger") or n:find("scythe") or n:find("machete") or n:find("blade") or n:find("dao") then
		return "Murder"
	end
	if n:find("gun") or n:find("revolver") or n:find("luger") or n:find("bringer") or n:find("shark") or n:find("laser") or n:find("blaster") or n:find("sung") then
		return "Sheriff"
	end

	local hasRemote = false
	for _, d in ipairs(tool:GetDescendants()) do
		local dn = d.Name:lower()
		if dn:find("knife") or dn:find("slash") or dn:find("stab") or dn:find("throw") then
			return "Murder"
		end
		if dn:find("gun") or dn:find("shoot") or dn:find("bullet") or dn:find("ammo") or dn:find("revolver") or dn:find("beam") then
			return "Sheriff"
		end
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
			hasRemote = true
		end
	end

	if hasRemote and tool:FindFirstChild("Handle") then
		for _, s in ipairs(tool:GetDescendants()) do
			if s:IsA("Sound") and (s.Name:lower():find("fire") or s.Name:lower():find("shoot") or s.Name:lower():find("reload")) then
				return "Sheriff"
			end
		end
		return "Murder"
	end

	return nil
end

function UI.getServerData()
	local ok, data = pcall(function()
		for _, obj in ipairs(RS:GetDescendants()) do
			if obj:IsA("RemoteFunction") and (obj.Name == "GetPlayerData" or obj.Name:lower():find("playerdata")) then
				return obj:InvokeServer()
			end
		end
		return nil
	end)
	return (ok and type(data) == "table" and next(data) ~= nil) and data or nil
end

function UI.getRole(p, data)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not p.Character or (hum and hum.Health <= 0) then
		UI.roleCache[p.UserId] = nil
		return "Innocent"
	end

	if data then
		local pData = data[p.Name]
		if not pData then UI.roleCache[p.UserId] = nil; return "Innocent" end
		local r = tostring(pData.Role or pData.role or ""):lower()
		if isIgnored(r) then UI.roleCache[p.UserId] = nil; return "Innocent" end
		if r:find("murder") or r == "killer" then UI.roleCache[p.UserId] = "Murder"; return "Murder" end
		if r:find("sheriff") or r:find("hero") or r:find("police") then UI.roleCache[p.UserId] = "Sheriff"; return "Sheriff" end
		UI.roleCache[p.UserId] = nil
		return "Innocent"
	end

	for k, v in pairs(p:GetAttributes()) do
		local val = tostring(v):lower()
		if not isIgnored(val) then
			if val == "murderer" or val == "murder" or val == "killer" then UI.roleCache[p.UserId] = "Murder"; return "Murder" end
			if val == "sheriff" or val == "police" or val == "hero" then UI.roleCache[p.UserId] = "Sheriff"; return "Sheriff" end
		end
	end
	if p.Team then
		local t = p.Team.Name:lower()
		if not isIgnored(t) then
			if t:find("murder") or t == "killer" then UI.roleCache[p.UserId] = "Murder"; return "Murder" end
			if t:find("sheriff") or t:find("police") or t == "hero" then UI.roleCache[p.UserId] = "Sheriff"; return "Sheriff" end
		end
	end

	local hasWeapon = false
	for _, box in ipairs({p:FindFirstChild("Backpack"), p.Character}) do
		if box then
			for _, t in ipairs(box:GetChildren()) do
				if t:IsA("Tool") then
					local detected = checkToolType(t)
					if detected then
						hasWeapon = true
						UI.roleCache[p.UserId] = detected
						return detected
					end
				end
			end
		end
	end

	if not hasWeapon then
		local bp = p:FindFirstChild("Backpack")
		if bp and #bp:GetChildren() == 0 then UI.roleCache[p.UserId] = nil end
	end

	return UI.roleCache[p.UserId] or "Innocent"
end

function UI.updateScan()
	for _, c in ipairs(UI.list:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
	local data = UI.getServerData()

	if not data then
		local anyWep = false
		for _, p in ipairs(Players:GetPlayers()) do
			for _, box in ipairs({p:FindFirstChild("Backpack"), p.Character}) do
				if box then
					for _, t in ipairs(box:GetChildren()) do
						if t:IsA("Tool") and checkToolType(t) then anyWep = true; break end
					end
				end
			end
		end
		if not anyWep then table.clear(UI.roleCache) end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		local col = COLS[UI.getRole(p, data)]
		if p ~= LP and p.Character then
			local hl = p.Character:FindFirstChild("RoleHL")
			if UI.scan then
				hl = hl or UI.make("Highlight", {Name = "RoleHL", FillTransparency = 0.25, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, p.Character)
				hl.Adornee, hl.Enabled, hl.FillColor, hl.OutlineColor = p.Character, true, col, col
			elseif hl then hl:Destroy() end
		end
		if UI.scan then
			local lbl = UI.make("TextLabel", {Size = UDim2.new(1, -4, 0, 20), BackgroundColor3 = Color3.fromRGB(45, 30, 68), Text = " " .. (p.DisplayName ~= "" and p.DisplayName or p.Name), TextColor3 = col, Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Active = false}, UI.list)
			UI.make("UICorner", {CornerRadius = UDim.new(0, 4)}, lbl)
		end
	end
end
