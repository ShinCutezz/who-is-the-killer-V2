local function addSlider(txt, y, minV, maxV, defV, key)
	local lbl = UI.make("TextLabel", {Size = UDim2.new(1, -10, 0, 15), Position = UDim2.new(0, 5, 0, y), BackgroundTransparency = 1, Text = txt .. ": " .. defV, TextColor3 = Color3.fromRGB(230, 200, 255), Font = Enum.Font.GothamBold, TextSize = 10, Active = false}, UI.left)
	local bg = UI.make("TextButton", {Size = UDim2.new(1, -14, 0, 10), Position = UDim2.new(0, 7, 0, y + 17), BackgroundColor3 = Color3.fromRGB(52, 36, 80), Text = "", AutoButtonColor = false, Selectable = false, Modal = false}, UI.left)
	local fill = UI.make("Frame", {Size = UDim2.new((defV - minV) / (maxV - minV), 0, 1, 0), BackgroundColor3 = Color3.fromRGB(185, 75, 255), Active = false}, bg)
	UI.make("UICorner", {CornerRadius = UDim.new(1, 0)}, bg)
	UI.make("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)

	local activeTouch = nil
	local function upd(x)
		local pct = math.clamp((x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
		local val = math.floor(minV + pct * (maxV - minV))
		UI[key] = val
		lbl.Text = txt .. ": " .. val
		fill.Size = UDim2.new(pct, 0, 1, 0)
	end
	bg.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			activeTouch = i
			upd(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if i == activeTouch then
			upd(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i == activeTouch then
			activeTouch = nil
		end
	end)
	return fill
end

