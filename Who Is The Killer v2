local COINS = {"coin", "token", "candy", "pumpkin", "snow", "egg", "star", "gem", "event", "xu", "money", "cash", "ball", "treat"}
local GUNS  = {"gundrop", "droppedgun", "sheriffgun", "revolver", "gun"}
local OFF_COL = Color3.fromRGB(48, 32, 74)
local lastSafeCFrame = nil

RunService.Stepped:Connect(function()
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if UI.noclip and char and root and hum then
		if hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > -30 then lastSafeCFrame = root.CFrame end
		if root.Position.Y < -50 and lastSafeCFrame then root.AssemblyLinearVelocity = Vector3.zero; root.CFrame = lastSafeCFrame + Vector3.new(0, 3, 0) end
		local footY = root.Position.Y - (hum.HipHeight + root.Size.Y * 0.5) + 0.4
		for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
		for _, obj in ipairs(workspace:GetPartBoundsInRadius(root.Position, 8)) do
			if not obj:IsDescendantOf(char) and obj.CanCollide then
				if (obj.Position.Y + obj.Size.Y * 0.5) > footY + 0.5 then
					obj.CanCollide = false
					task.delay(0.3, function() if obj and obj.Parent then obj.CanCollide = true end end)
				end
			end
		end
	end

	if UI.hb then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and p.Character then
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				if hrp then hrp.CanCollide = false end
			end
		end
	end
end)

local function hasKey(o, tbl)
	local s = (o.Name .. (o.Parent and o.Parent.Name or "")):lower()
	for _, k in ipairs(tbl) do if s:find(k, 1, true) then return true end end
end

