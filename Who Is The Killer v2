function UI.updateHitbox()
	local data = UI.getServerData()
	local myRole = UI.getRole(LP, data)

	local sheriffAlive = false
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and UI.getRole(p, data) == "Sheriff" then
				sheriffAlive = true
				break
			end
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local torso = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso")
			if hrp then
				local isAlive = hum and hum.Health > 0
				local targetRole = UI.getRole(p, data)
				local shouldExpand = false

				if UI.hb and isAlive then
					if myRole == "Sheriff" then
						shouldExpand = (targetRole == "Murder")
					elseif myRole == "Murder" then
						if sheriffAlive then
							shouldExpand = (targetRole == "Sheriff")
						else
							shouldExpand = (targetRole == "Innocent")
						end
					else
						shouldExpand = (targetRole == "Murder")
					end
				end

				if shouldExpand then
					local s = UI.hbSize
					local boxSize = Vector3.new(s, s, s)

					hrp.Size = boxSize
					hrp.Transparency = UI.showHb and 0.78 or 1
					hrp.Color = UI.COLS[targetRole] or Color3.fromRGB(185, 75, 255)
					hrp.Material = Enum.Material.Neon
					hrp.CastShadow = false
					hrp.CanCollide = false
					hrp.CanQuery = true
					hrp.CanTouch = true

					if torso then
						if not torso:GetAttribute("OrigSize") then
							torso:SetAttribute("OrigSize", torso.Size)
						end
						torso.Size = boxSize
						torso.Massless = true
						torso.CanCollide = false
						torso.CanQuery = true
						torso.CanTouch = true
					end
				else
					hrp.Size = Vector3.new(2, 2, 1)
					hrp.Transparency = 1
					hrp.CanCollide = false
					if torso and torso:GetAttribute("OrigSize") then
						torso.Size = torso:GetAttribute("OrigSize")
						torso.Massless = false
					end
				end
			end
		end
	end
end
